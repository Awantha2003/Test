# Firebase web app config (public; protected by rules + App Check)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=rakawala-dev.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=rakawala-dev
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FUNCTIONS_REGION=asia-south1
# reCAPTCHA Enterprise site key for App Check (leave empty in local dev)
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=
# Map tiles: use a commercial provider in production (OSM policy forbids heavy use)
NEXT_PUBLIC_MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
NEXT_PUBLIC_MAP_ATTRIBUTION=&copy; OpenStreetMap contributors
# Local development against emulators
NEXT_PUBLIC_USE_EMULATORS=false
